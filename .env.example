NODE_ENV=development
HOST=127.0.0.1
PORT=5001
CLIENT_ORIGIN=http://localhost:5174

# Create this MySQL database with utf8mb4 before running npm run db:check.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldbridge
DB_USER=fieldbridge
DB_PASSWORD=replace_with_your_mysql_password
DB_LOGGING=false

# Development only: OTP is printed in the backend terminal, never in the API.
# Console OTP is always disabled in production. A real SMS provider comes later.
OTP_MODE=console
# Optional in development. Changing this invalidates pending OTPs.
# Use a long random value to keep pending OTPs valid across server restarts.
OTP_SECRET=

# Run npm run admin after setting these values in the ROOT .env.
# ADMIN_PHONE and ADMIN_PASSWORD are required. Email is optional.
# Use a unique phone number and a password of 12–128 characters.
# Re-running the command never changes an existing account or its password.
ADMIN_NAME=ফিল্ডব্রিজ অ্যাডমিন
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# স্থানীয় development-এ ঐচ্ছিক। একাধিক backend চালালে একই দীর্ঘ random secret ব্যবহার করুন।
# খালি রাখলে সার্ভার পুনরায় চালুর পরে অর্ডারের নিশ্চিতকরণের তথ্য আবার খুলতে হবে।
ORDER_QUOTE_SECRET=
